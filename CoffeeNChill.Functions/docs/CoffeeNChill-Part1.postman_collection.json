{
  "info": {
    "_postman_id": "1f0d55cf-3d75-4d2f-bd9c-0bcb5e3f0e11",
    "name": "CoffeeNChill Part 1",
    "description": "Postman tests for the CoffeeNChill Azure Functions menu and staff document APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7071/api"
    },
    {
      "key": "category",
      "value": "Hot Drinks"
    },
    {
      "key": "itemId",
      "value": "COF-001"
    },
    {
      "key": "uploadedFileName",
      "value": ""
    },
    {
      "key": "filePath",
      "value": "C:/path/to/recipe.pdf"
    }
  ],
  "item": [
    {
      "name": "Menu",
      "item": [
        {
          "name": "Create menu item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partitionKey\": \"{{category}}\",\n  \"rowKey\": \"{{itemId}}\",\n  \"name\": \"Espresso\",\n  \"description\": \"Double-shot espresso\",\n  \"price\": 2.5,\n  \"isAvailable\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('returns the created item', function () { pm.expect(pm.response.json().rowKey).to.eql(pm.variables.get('itemId')); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get all menu items",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('returns an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get menu items by category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/menu/category/{{category}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu",
                "category",
                "{{category}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('returns an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update menu item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 3.0,\n  \"isAvailable\": false,\n  \"description\": \"Temporarily unavailable\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/menu/{{category}}/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu",
                "{{category}}",
                "{{itemId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('updates the price', function () { pm.expect(pm.response.json().price).to.eql(3); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Delete menu item",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/menu/{{category}}/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu",
                "{{category}}",
                "{{itemId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 200 OK', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "Upload staff document",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{filePath}}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/documents/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "upload"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('returns the uploaded filename', function () { pm.expect(pm.response.json().fileName).to.be.a('string'); });",
                  "pm.collectionVariables.set('uploadedFileName', pm.response.json().fileName);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List staff documents",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('returns an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Download staff document",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/documents/download/{{uploadedFileName}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "download",
                "{{uploadedFileName}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('returns binary content', function () { pm.expect(pm.response.headers.get('Content-Type')).to.eql('application/octet-stream'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
